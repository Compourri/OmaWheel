{
  "schemaVersion": 1,
  "id": "oma.wheel",
  "name": "OmaWheel",
  "version": "0.1.1",
  "author": "Compourri",
  "license": "MIT",
  "description": "Weapon-wheel style radial menu for Omarchy. Auto-populates from omarchy-menu.jsonc like the built-in menu.",
  "keywords": [
    "menu",
    "radial",
    "wheel",
    "weapon-wheel",
    "quickshell"
  ],
  "kinds": [
    "menu",
    "bar-widget"
  ],
  "replaces": [
    "omarchy.menu"
  ],
  "barWidget": {
    "defaultSection": "left"
  },
  "keepLoaded": true,
  "entryPoints": {
    "menu": "Menu.qml"
  }
}
